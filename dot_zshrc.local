# default env settings
export LANG=en_US.UTF-8
export TERM=xterm-256color
export LESS='-FR'

if command -v nvim > /dev/null 2>&1; then
  export EDITOR=nvim
else
  export EDITOR=vim
fi

# zsh settings
setopt AUTO_CD
# change key map
bindkey -e
# prepare completion style
autoload -Uz compinit && compinit
# completion matching
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|[._-]=* r:|=*' 'l:|=* r:|=*'
# completion menu
zstyle ':completion:*' menu select
# completion colors
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
# completion ignore duplicates
zstyle ':completion:*:(rm|mv|cp|kill|diff):*' ignore-line other

# fzf settings
if command -v fzf > /dev/null 2>&1; then
  source <(fzf --zsh)
  export FZF_DEFAULT_OPTS=" \
  --color=bg+:#363A4F,bg:#24273A,spinner:#F4DBD6,hl:#ED8796 \
  --color=fg:#CAD3F5,header:#ED8796,info:#C6A0F6,pointer:#F4DBD6 \
  --color=marker:#B7BDF8,fg+:#CAD3F5,prompt:#C6A0F6,hl+:#ED8796 \
  --color=selected-bg:#494D64 \
  --color=border:#6E738D,label:#CAD3F5"
fi

# man settings
if command -v bat > /dev/null 2>&1; then
  export MANPAGER="sh -c 'col -bx | bat -l man -p'"
fi

# go env settings
if command -v go > /dev/null 2>&1; then
  export GOPATH="$HOME/.go"
  export GOBIN="$GOPATH/bin"
  export PATH=$PATH:$GOBIN
fi

# direnv settings
if command -v direnv > /dev/null 2>&1; then
  eval "$(direnv hook zsh)"
fi

# starship settings
if command -v starship > /dev/null 2>&1; then
  export STARSHIP_CONFIG=~/.config/starship/starship.toml
  eval "$(starship init zsh)"
fi

# common aliases
[[ -r "$HOME/.alias" ]] && source "$HOME/.alias"

# os specific settings
case "$OSTYPE" in
  darwin*) [[ -r "$HOME/.zshrc.local.darwin" ]] && source "$HOME/.zshrc.local.darwin" ;;
  linux*)  [[ -r "$HOME/.zshrc.local.linux" ]] && source "$HOME/.zshrc.local.linux" ;;
esac

# zsh plugins
[[ -r ~/.zsh_plugins/zsh-autosuggestions/zsh-autosuggestions.zsh ]] &&
  source ~/.zsh_plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
[[ -r ~/.zsh_plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]] &&
  source ~/.zsh_plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
